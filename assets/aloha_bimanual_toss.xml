<mujoco model="aloha_bimanual_toss_catch">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>

  <option integrator="Euler" timestep="0.002" gravity="0 0 -9.81">
    <flag contact="enable" energy="enable"/>
  </option>

  <visual>
    <headlight ambient="0.15 0.18 0.22" diffuse="0.8 0.85 0.9" specular="0.3 0.3 0.3"/>
    <quality shadowsize="4096"/>
    <global azimuth="140" elevation="-25" offwidth="1920" offheight="1080"/>
  </visual>

  <asset>
    <!-- Dark Studio Aesthetics & Textures -->
    <texture type="skybox" builtin="gradient" rgb1="0.03 0.04 0.06" rgb2="0.08 0.1 0.14" width="512" height="512"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.05 0.06 0.08" rgb2="0.08 0.09 0.12" markrgb="0.15 0.2 0.28" width="500" height="500"/>
    <material name="groundmat" texture="groundplane" texuniform="true" texrepeat="15 15" reflectance="0.18" roughness="0.4"/>
    
    <material name="dark_carbon" rgba="0.12 0.13 0.15 1.0" specular="0.8" shininess="0.9" roughness="0.2"/>
    <material name="anodized_cyan" rgba="0.0 0.75 0.9 1.0" specular="0.9" shininess="0.9"/>
    <material name="anodized_magenta" rgba="0.95 0.15 0.45 1.0" specular="0.9" shininess="0.9"/>
    <material name="matte_silver" rgba="0.75 0.78 0.82 1.0" specular="0.6" roughness="0.3"/>
    <material name="neon_target" rgba="0.0 1.0 0.6 0.85" emission="0.6"/>
    <material name="neon_trajectory" rgba="0.2 0.8 1.0 0.6" emission="0.8"/>
    <material name="projectile_mat" rgba="1.0 0.4 0.1 1.0" specular="0.9" shininess="0.9" emission="0.2"/>
    <material name="cushion_pad" rgba="0.1 0.7 0.4 1.0" roughness="0.9" reflectance="0.05"/>
  </asset>

  <default>
    <joint limited="true" damping="1.5" armature="0.08" frictionloss="0.1"/>
    <geom contype="1" conaffinity="1" condim="4" friction="1.2 0.01 0.001" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <default class="thrower">
      <geom material="dark_carbon"/>
    </default>
    <default class="catcher">
      <geom material="dark_carbon"/>
    </default>
    <default class="cushion_geom">
      <geom material="cushion_pad" friction="2.0 0.05 0.005" solref="0.02 1.5" solimp="0.8 0.95 0.001"/>
    </default>
  </default>

  <worldbody>
    <light directional="true" pos="-0.5 1.5 3.0" dir="0.2 -0.5 -1" diffuse="0.9 0.9 0.95" specular="0.4 0.4 0.4" castshadow="true"/>
    <light directional="true" pos="1.5 -1.0 2.5" dir="-0.5 0.3 -1" diffuse="0.3 0.4 0.6" specular="0.2 0.2 0.3"/>
    
    <!-- Arena Ground Floor -->
    <geom name="floor" type="plane" size="3 3 0.1" material="groundmat"/>
    <geom name="table" type="box" pos="0 0 0.35" size="0.9 0.5 0.35" rgba="0.08 0.09 0.12 1.0" material="dark_carbon" solref="0.001 1" solimp="0.99 0.999 0.001"/>
    <geom name="table_trim" type="box" pos="0 0 0.705" size="0.91 0.51 0.005" material="anodized_cyan" solref="0.001 1" solimp="0.99 0.999 0.001"/>

    <!-- Arena Target Flush Visualization Sites (Flush with table surface, no floating cylinder clipping) -->
    <site name="toss_launch_zone" pos="-0.25 0 0.712" size="0.08 0.08 0.001" type="cylinder" material="anodized_magenta"/>
    <site name="toss_apex_zone" pos="0.0 0 1.25" size="0.04" type="sphere" material="neon_trajectory"/>
    <site name="catch_target_zone" pos="0.25 0 0.712" size="0.09 0.09 0.001" type="cylinder" material="neon_target"/>

    <!-- ============================================================== -->
    <!-- LEFT ARM: 7-DOF HIGH-SPEED THROWER (Base at X = -0.50m)        -->
    <!-- ============================================================== -->
    <body name="left_base" pos="-0.50 0 0.71">
      <geom name="left_pedestal" type="cylinder" size="0.07 0.05" pos="0 0 0.05" material="dark_carbon" solref="0.002 1" solimp="0.98 0.995 0.001"/>
      <geom name="left_accent" type="cylinder" size="0.072 0.005" pos="0 0 0.10" material="anodized_magenta" contype="0" conaffinity="0"/>
      
      <!-- J1: Waist / Yaw -->
      <body name="left_link1" pos="0 0 0.105">
        <joint name="left_waist" type="hinge" axis="0 0 1" range="-2.6 2.6"/>
        <geom type="cylinder" size="0.058 0.07" pos="0 0 0.07" material="dark_carbon"/>
        
        <!-- J2: Shoulder / Pitch (Realistic Mechanical Stop at -0.35 rad) -->
        <body name="left_link2" pos="0 0 0.15">
          <joint name="left_shoulder" type="hinge" axis="0 1 0" range="-0.35 1.8"/>
          <geom type="capsule" size="0.048 0.11" pos="0 0 0.11" material="matte_silver"/>
          <geom type="cylinder" size="0.05 0.015" pos="0 0 0.22" material="anodized_magenta" contype="0" conaffinity="0"/>

          <!-- J3: Shoulder Roll -->
          <body name="left_link3" pos="0 0 0.22">
            <joint name="left_shoulder_roll" type="hinge" axis="0 0 1" range="-2.2 2.2"/>
            <geom type="capsule" size="0.045 0.10" pos="0 0 0.10" material="dark_carbon"/>

            <!-- J4: Elbow / Pitch (High-speed Flick Joint) -->
            <body name="left_link4" pos="0 0 0.20">
              <joint name="left_elbow" type="hinge" axis="0 1 0" range="-2.2 2.4" damping="0.8"/>
              <geom type="capsule" size="0.04 0.11" pos="0 0 0.11" material="matte_silver"/>

              <!-- J5: Forearm Roll -->
              <body name="left_link5" pos="0 0 0.22">
                <joint name="left_forearm_roll" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
                <geom type="cylinder" size="0.038 0.04" pos="0 0 0.04" material="dark_carbon"/>

                <!-- J6: Wrist Pitch -->
                <body name="left_link6" pos="0 0 0.08">
                  <joint name="left_wrist_pitch" type="hinge" axis="0 1 0" range="-1.6 1.6" damping="0.5"/>
                  <geom type="box" size="0.035 0.04 0.03" pos="0 0 0.03" material="anodized_magenta"/>

                  <!-- J7: Wrist Roll & Gripper Base -->
                  <body name="left_link7" pos="0 0 0.06">
                    <joint name="left_wrist_roll" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="0.3"/>
                    <geom type="box" size="0.045 0.05 0.02" pos="0 0 0.02" material="dark_carbon"/>
                    <site name="left_hand_site" pos="0 0 0.10" size="0.015" material="neon_trajectory"/>
                    
                    <!-- Left Finger 1 -->
                    <body name="left_finger_left" pos="0 0.025 0.04">
                      <joint name="left_gripper_finger1" type="slide" axis="0 1 0" range="0.0 0.045" damping="2.0"/>
                      <geom type="box" size="0.01 0.008 0.04" pos="0 0 0.04" material="dark_carbon" friction="2.5 0.1 0.01"/>
                      <geom class="cushion_geom" type="box" size="0.008 0.004 0.035" pos="0 -0.006 0.04"/>
                    </body>
                    <!-- Left Finger 2 -->
                    <body name="left_finger_right" pos="0 -0.025 0.04">
                      <joint name="left_gripper_finger2" type="slide" axis="0 -1 0" range="0.0 0.045" damping="2.0"/>
                      <geom type="box" size="0.01 0.008 0.04" pos="0 0 0.04" material="dark_carbon" friction="2.5 0.1 0.01"/>
                      <geom class="cushion_geom" type="box" size="0.008 0.004 0.035" pos="0 0.006 0.04"/>
                    </body>
                    <!-- Left Camera (Wrist PiP) -->
                    <camera name="left_wrist_cam" pos="0.06 0 0.08" euler="0.3 0.8 1.57" fovy="65"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ============================================================== -->
    <!-- RIGHT ARM: 7-DOF DYNAMIC CATCHER (Base at X = +0.50m)          -->
    <!-- ============================================================== -->
    <body name="right_base" pos="0.50 0 0.71">
      <geom name="right_pedestal" type="cylinder" size="0.07 0.05" pos="0 0 0.05" material="dark_carbon" solref="0.002 1" solimp="0.98 0.995 0.001"/>
      <geom name="right_accent" type="cylinder" size="0.072 0.005" pos="0 0 0.10" material="anodized_cyan" contype="0" conaffinity="0"/>
      
      <!-- J1: Waist / Yaw -->
      <body name="right_link1" pos="0 0 0.105">
        <joint name="right_waist" type="hinge" axis="0 0 1" range="-2.6 2.6"/>
        <geom type="cylinder" size="0.058 0.07" pos="0 0 0.07" material="dark_carbon"/>
        
        <!-- J2: Shoulder / Pitch (Realistic Mechanical Stop at -0.35 rad) -->
        <body name="right_link2" pos="0 0 0.15">
          <joint name="right_shoulder" type="hinge" axis="0 1 0" range="-0.35 1.8"/>
          <geom type="capsule" size="0.048 0.11" pos="0 0 0.11" material="matte_silver"/>
          <geom type="cylinder" size="0.05 0.015" pos="0 0 0.22" material="anodized_cyan" contype="0" conaffinity="0"/>

          <!-- J3: Shoulder Roll -->
          <body name="right_link3" pos="0 0 0.22">
            <joint name="right_shoulder_roll" type="hinge" axis="0 0 1" range="-2.2 2.2"/>
            <geom type="capsule" size="0.045 0.10" pos="0 0 0.10" material="dark_carbon"/>

            <!-- J4: Elbow / Pitch -->
            <body name="right_link4" pos="0 0 0.20">
              <joint name="right_elbow" type="hinge" axis="0 1 0" range="-2.2 2.4" damping="1.2"/>
              <geom type="capsule" size="0.04 0.11" pos="0 0 0.11" material="matte_silver"/>

              <!-- J5: Forearm Roll -->
              <body name="right_link5" pos="0 0 0.22">
                <joint name="right_forearm_roll" type="hinge" axis="0 0 1" range="-2.8 2.8"/>
                <geom type="cylinder" size="0.038 0.04" pos="0 0 0.04" material="dark_carbon"/>

                <!-- J6: Wrist Pitch -->
                <body name="right_link6" pos="0 0 0.08">
                  <joint name="right_wrist_pitch" type="hinge" axis="0 1 0" range="-1.6 1.6" damping="0.8"/>
                  <geom type="box" size="0.035 0.04 0.03" pos="0 0 0.03" material="anodized_cyan"/>

                  <!-- J7: Wrist Roll & Catcher End-Effector -->
                  <body name="right_link7" pos="0 0 0.06">
                    <joint name="right_wrist_roll" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="0.5"/>
                    <geom type="box" size="0.045 0.06 0.02" pos="0 0 0.02" material="dark_carbon"/>
                    <site name="right_catch_center" pos="0 0 0.08" size="0.02" material="neon_target"/>
                    
                    <!-- High-compliance Soft Catching Paddle / Basket with Sensors -->
                    <geom class="cushion_geom" name="right_cushion_base" type="box" size="0.06 0.07 0.012" pos="0 0 0.04"/>
                    <geom class="cushion_geom" name="right_rim_fwd" type="box" size="0.06 0.008 0.025" pos="0 0.065 0.055"/>
                    <geom class="cushion_geom" name="right_rim_bwd" type="box" size="0.06 0.008 0.025" pos="0 -0.065 0.055"/>
                    <geom class="cushion_geom" name="right_rim_left" type="box" size="0.008 0.06 0.025" pos="-0.055 0 0.055"/>
                    <geom class="cushion_geom" name="right_rim_right" type="box" size="0.008 0.06 0.025" pos="0.055 0 0.055"/>

                    <!-- Right Camera (Wrist PiP) -->
                    <camera name="right_wrist_cam" pos="-0.06 0 0.08" euler="-0.3 -0.8 -1.57" fovy="65"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ============================================================== -->
    <!-- BALLISTIC PROJECTILE (Target Object: Aerodynamic Capsule/Cube)  -->
    <!-- ============================================================== -->
    <body name="projectile" pos="-0.25 0 0.88">
      <freejoint name="projectile_joint"/>
      <geom name="projectile_geom" type="capsule" size="0.025 0.02" mass="0.08" material="projectile_mat" friction="1.8 0.05 0.005" solref="0.008 1" solimp="0.9 0.98 0.001"/>
      <site name="projectile_center" pos="0 0 0" size="0.01" material="neon_target"/>
    </body>

    <!-- Studio Overview Cameras (Widescreen Full Arena Coverage) -->
    <camera name="front_overview" pos="0 -1.8 1.4" euler="1.1 0 0" fovy="62"/>
    <camera name="side_cinematic" pos="-1.8 0 1.3" euler="0.8 -1.15 -1.57" fovy="58"/>
    <camera name="top_tactical" pos="0 0 2.5" euler="0 0 0" fovy="65"/>
  </worldbody>

  <!-- ================================================================ -->
  <!-- ACTUATORS: High-Speed Torque & Position Controlled Motors        -->
  <!-- ================================================================ -->
  <actuator>
    <!-- Left Arm Thrower Actuators -->
    <motor name="act_left_waist" joint="left_waist" gear="80" ctrlrange="-1 1"/>
    <motor name="act_left_shoulder" joint="left_shoulder" gear="100" ctrlrange="-1 1"/>
    <motor name="act_left_shoulder_roll" joint="left_shoulder_roll" gear="60" ctrlrange="-1 1"/>
    <motor name="act_left_elbow" joint="left_elbow" gear="70" ctrlrange="-1 1"/>
    <motor name="act_left_forearm_roll" joint="left_forearm_roll" gear="40" ctrlrange="-1 1"/>
    <motor name="act_left_wrist_pitch" joint="left_wrist_pitch" gear="30" ctrlrange="-1 1"/>
    <motor name="act_left_wrist_roll" joint="left_wrist_roll" gear="20" ctrlrange="-1 1"/>
    <position name="act_left_finger1" joint="left_gripper_finger1" kp="800" kv="40" ctrlrange="0 0.045"/>
    <position name="act_left_finger2" joint="left_gripper_finger2" kp="800" kv="40" ctrlrange="0 0.045"/>

    <!-- Right Arm Catcher Actuators -->
    <motor name="act_right_waist" joint="right_waist" gear="80" ctrlrange="-1 1"/>
    <motor name="act_right_shoulder" joint="right_shoulder" gear="100" ctrlrange="-1 1"/>
    <motor name="act_right_shoulder_roll" joint="right_shoulder_roll" gear="60" ctrlrange="-1 1"/>
    <motor name="act_right_elbow" joint="right_elbow" gear="70" ctrlrange="-1 1"/>
    <motor name="act_right_forearm_roll" joint="right_forearm_roll" gear="40" ctrlrange="-1 1"/>
    <motor name="act_right_wrist_pitch" joint="right_wrist_pitch" gear="30" ctrlrange="-1 1"/>
    <motor name="act_right_wrist_roll" joint="right_wrist_roll" gear="20" ctrlrange="-1 1"/>
  </actuator>

  <!-- ================================================================ -->
  <!-- SENSORS: Telemetry and Dynamic Contact Interception              -->
  <!-- ================================================================ -->
  <sensor>
    <touch name="sensor_catcher_touch" site="right_catch_center"/>
    <framepos name="sensor_projectile_pos" objtype="site" objname="projectile_center"/>
    <framelinvel name="sensor_projectile_vel" objtype="site" objname="projectile_center"/>
    <framepos name="sensor_left_hand_pos" objtype="site" objname="left_hand_site"/>
    <framepos name="sensor_right_catch_pos" objtype="site" objname="right_catch_center"/>
  </sensor>

  <!-- ================================================================ -->
  <!-- CONTACT: Collision Filtering & Smooth Bearing Motion             -->
  <!-- ================================================================ -->
  <contact>
    <exclude body1="left_base" body2="left_link1"/>
    <exclude body1="right_base" body2="right_link1"/>
    <exclude body1="left_link1" body2="left_link2"/>
    <exclude body1="right_link1" body2="right_link2"/>
  </contact>
</mujoco>
